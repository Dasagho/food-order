# URL base del backend food-order-api (sin barra final). Se incrusta al compilar.
# Vacía = mismo origen: en desarrollo `vite dev` reenvía /v1 a DEV_API_TARGET (por defecto http://localhost:3000).
VITE_API_URL=http://localhost:3000

# Solo `npm run dev` (servidor de Vite): destino al que se reenvía /v1 (DEV_API_TARGET) y /media (DEV_MEDIA_TARGET,
# imágenes de productos; por defecto el mismo que /v1, que sirve GET /media/:key con STORAGE_DRIVER=fs).
# Con un bucket S3/RustFS, apunta DEV_MEDIA_TARGET a la base pública del bucket (p. ej. un túnel a
# http://rustfs:9000/food-order/images) o a un reverse proxy que ya enrute /media. No se incrusta en la app.
# DEV_API_TARGET=http://localhost:3000
# DEV_MEDIA_TARGET=http://localhost:3000

# "1" muestra el botón «Acceso de desarrollo» (POST /v1/auth/dev-login). El backend solo lo expone con
# AUTH_DEV_BYPASS=1. NO activar en producción.
VITE_DEV_LOGIN=1

# "0" muestra cifras occidentales (0123) en árabe; por defecto ٠١٢٣. Se incrusta al compilar.
# VITE_ARABIC_DIGITS=0


# =============================================================================
# Docker Compose  (docker compose up -d --build)  — ver docker-compose.yml
# Los nombres de esta sección NO empiezan por VITE_ a propósito: Vite solo expone VITE_* al navegador,
# y así `npm run dev` y `docker compose` pueden compartir el mismo .env sin pisarse.
# =============================================================================

# URL pública desde la que se abre la app (la ve el navegador). La URI de redirección registrada en Azure es
#   ${PUBLIC_URL}/v1/auth/microsoft/callback
PUBLIC_URL=http://localhost:8080
# Por defecto solo escucha en loopback; expón el puerto al exterior a través de tu proxy TLS.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Correos Microsoft con acceso (obligatorio, separados por comas) y datos de la app de Azure.
ALLOWED_EMAILS=
MS_CLIENT_ID=
# En producción pon tu tenant ID (o `consumers`): con `common` la lista de correos es la única barrera.
MS_TENANT=common
# El secreto de cliente y JWT_SECRET NO van aquí: ./docker/init-secrets.sh los crea en ./secrets/

# --- Imágenes de productos (SPEC §6.6) ---
# El navegador las pide a /media/<clave>.webp en el mismo origen que la app. Quién las sirve:
# (a) el nginx del contenedor `web`, hacia MEDIA_UPSTREAM (se fija al construir la imagen):
#       arranque rápido (STORAGE_DRIVER=fs): http://api:3000/media   <- valor por defecto si no se define
#       RustFS (STORAGE_DRIVER=s3):          http://rustfs:9000/<bucket>/<prefijo sin barra final>
#         p. ej. http://rustfs:9000/food-order/images   (S3_ENDPOINT/S3_BUCKET/S3_KEY_PREFIX sin la barra final)
#       y la red externa `rustfs` descomentada en docker-compose.yml.
# (b) el reverse proxy de delante enruta /media/* al bucket (solo GET/HEAD): deja MEDIA_UPSTREAM= vacío
#       y `web` responderá 404 a /media/.
# MEDIA_UPSTREAM=http://api:3000/media
# Controlador de almacenamiento de la API: fs (disco, desarrollo y tests) o s3 (RustFS).
# STORAGE_DRIVER=fs
# IMAGES_PUBLIC_PATH=/media
# S3_ENDPOINT=http://rustfs:9000
# S3_BUCKET=food-order
# S3_KEY_PREFIX=images/
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# Las credenciales (S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY) NO van aquí: ./docker/init-secrets.sh las guarda en
# ./secrets/s3_access_key_id y ./secrets/s3_secret_access_key (rutas cambiables con S3_ACCESS_KEY_ID_PATH / S3_SECRET_ACCESS_KEY_PATH).

# API en OTRO dominio (opcional; vacío = mismo origen con proxy nginx a la API del compose).
# WEB_API_URL=https://api.midominio.es

# Solo desarrollo con Compose (NO en producción): login sin Azure.
# API_NODE_ENV=development
# AUTH_DEV_BYPASS=1
# WEB_DEV_LOGIN=1

# Etiqueta de las imágenes y huella de versión incrustada en la app.
# TAG=latest
# BUILD_SHA=local
# BUSINESS_TZ=Europe/Madrid
# WEB_ARABIC_DIGITS=0
# API_CONTEXT=../food-order-api
