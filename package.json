{
  "name": "food-order",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "deploy": "push-dir --dir=dist --branch=gh-pages",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:upgrade": "node tests/e2e/upgrade.mjs",
    "test:e2e:real": "E2E_BACKEND=real playwright test",
    "test:upgrade:real": "E2E_BACKEND=real node tests/e2e/upgrade.mjs",
    "test:all": "vitest run && playwright test && node tests/e2e/upgrade.mjs",
    "typecheck": "tsc --noEmit",
    "fake-api": "node tests/fake-api/server.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.3"
  }
}
